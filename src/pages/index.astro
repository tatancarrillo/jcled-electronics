---
const services = [
  { number: '01', title: 'Audio profesional', description: 'Diagnóstico, reparación, configuración e integración de sistemas de sonido.' },
  { number: '02', title: 'Iluminación LED', description: 'Diseño, fabricación e instalación de iluminación para espacios y proyectos especiales.' },
  { number: '03', title: 'Pantallas LED', description: 'Instalación, mantenimiento y soporte para soluciones de comunicación visual.' },
  { number: '04', title: 'Avisos, letras 3D y neón', description: 'Piezas visuales fabricadas a medida para negocios, fachadas e interiores.' },
  { number: '05', title: 'Impresión 3D', description: 'Prototipos, repuestos y objetos personalizados creados según cada necesidad.' },
  { number: '06', title: 'Servicio técnico electrónico', description: 'Revisión y reparación de equipos electrónicos con atención especializada.' },
  { number: '07', title: 'Soluciones tecnológicas', description: 'Instalaciones e integración de tecnología para proyectos comerciales y particulares.' },
];

const projects = [
  { src: '/images/fachada-jc-led.webp', width: 1426, height: 1024, alt: 'Fachada de JC LED Electronics con iluminación cian y pantallas LED', title: 'Fachadas e iluminación', className: 'project-wide' },
  { src: '/images/vitrina-led.webp', width: 1536, height: 1024, alt: 'Vitrina iluminada de JC LED Electronics con productos de audio y tecnología', title: 'Vitrinas y avisos LED', className: '' },
  { src: '/images/interior-taller.webp', width: 1800, height: 1350, alt: 'Taller de JC LED Electronics con equipos, audio e impresoras 3D', title: 'Taller e instalaciones', className: '' },
];

const whatsappUrl = 'https://wa.me/573114308935?text=Hola%20JC%20LED%20Electronics%2C%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#05080a" />
    <meta name="description" content="JC LED Electronics: audio profesional, iluminación, pantallas LED, impresión 3D, servicio técnico y soluciones tecnológicas en La Dorada, Caldas." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="JC LED Electronics | Audio, iluminación y tecnología" />
    <meta property="og:description" content="Diseño, fabricación, instalación y servicio técnico en audio, iluminación y tecnología." />
    <meta property="og:image" content="/images/fachada-jc-led.webp" />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" type="image/png" href="/images/logo-jc-led.png" />
    <title>JC LED Electronics | Audio, iluminación y tecnología</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="JC LED Electronics, inicio"><img src="/images/logo-jc-led.png" width="320" height="227" alt="JC LED Electronics" /></a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#inicio">Inicio</a><a href="#servicios">Servicios</a><a href="#proyectos">Proyectos</a><a href="#nosotros">Nosotros</a><a class="nav-cta" href="#contacto">Contacto</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
          <nav aria-label="Navegación móvil"><a href="#inicio">Inicio</a><a href="#servicios">Servicios</a><a href="#proyectos">Proyectos</a><a href="#nosotros">Nosotros</a><a href="#contacto">Contacto</a></nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/fachada-jc-led.webp" width="1426" height="1024" alt="Fachada iluminada de JC LED Electronics en La Dorada" fetchpriority="high" />
        <div class="hero-shade"></div><div class="hero-grid" aria-hidden="true"></div>
        <div class="container hero-content">
          <p class="eyebrow"><span></span> La Dorada, Caldas</p>
          <h1 id="hero-title">JC LED<br /><em>Electronics</em></h1>
          <p class="hero-tagline">Audio, iluminación y tecnología</p>
          <p class="hero-copy">Diseñamos, fabricamos, instalamos y reparamos soluciones que hacen visible, audible y funcional cada idea.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#servicios">Ver servicios <span aria-hidden="true">↘</span></a>
            <a class="button button-ghost" href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-index" aria-hidden="true">JC / 001</div>
      </section>

      <section class="section services" id="servicios" aria-labelledby="services-title">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow"><span></span> Lo que hacemos</p><h2 id="services-title">Soluciones que<br /><em>conectan.</em></h2></div>
            <p>Integramos electrónica, fabricación y experiencia técnica para entregar soluciones completas, desde una reparación puntual hasta una instalación a medida.</p>
          </div>
          <div class="services-grid">
            {services.map((service) => (
              <article class="service-card"><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><span class="service-line" aria-hidden="true"></span></article>
            ))}
          </div>
        </div>
      </section>

      <section class="section projects" id="proyectos" aria-labelledby="projects-title">
        <div class="container">
          <div class="section-heading projects-heading">
            <div><p class="eyebrow"><span></span> Trabajo real</p><h2 id="projects-title">Proyectos y<br /><em>espacios.</em></h2></div>
            <p>Una muestra de nuestro trabajo en iluminación, comunicación visual, tecnología e instalaciones.</p>
          </div>
          <div class="project-grid">
            {projects.map((project, index) => (
              <figure class:list={['project-card', project.className]}>
                <img src={project.src} alt={project.alt} width={project.width} height={project.height} loading={index === 0 ? 'eager' : 'lazy'} />
                <figcaption><span>0{index + 1}</span>{project.title}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="section print-section" id="impresion-3d" aria-labelledby="print-title">
        <div class="container print-grid">
          <div class="print-image-wrap">
            <img src="/images/impresora-3d.webp" width="1200" height="1600" loading="lazy" alt="Impresora 3D trabajando en el taller de JC LED Electronics" /><span class="image-label">Fabricación / 3D</span>
          </div>
          <div class="print-copy">
            <p class="eyebrow"><span></span> De la idea a la pieza</p><h2 id="print-title">Impresión<br /><em>3D.</em></h2>
            <p>Diseño y fabricación de piezas personalizadas, prototipos, elementos decorativos y soluciones técnicas mediante impresión 3D.</p>
            <ul><li>Prototipos y piezas funcionales</li><li>Repuestos y soluciones a medida</li><li>Elementos decorativos personalizados</li></ul>
            <a class="text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Cuéntanos qué necesitas <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="section about" id="nosotros" aria-labelledby="about-title">
        <div class="container about-grid">
          <p class="eyebrow"><span></span> Nosotros</p>
          <div><h2 id="about-title">Tecnología con<br /><em>oficio.</em></h2><p class="about-lead">JC LED Electronics diseña, fabrica, instala, integra y repara soluciones relacionadas con electrónica, audio, iluminación y tecnología.</p></div>
          <p class="about-note">Trabajamos cada proyecto de forma directa, combinando diseño, fabricación y soporte técnico desde nuestro taller en La Dorada.</p>
        </div>
      </section>

      <section class="contact" id="contacto" aria-labelledby="contact-title">
        <div class="container contact-inner">
          <div><p class="eyebrow light"><span></span> Hablemos</p><h2 id="contact-title">Hagamos realidad<br /><em>tu proyecto.</em></h2></div>
          <div class="contact-actions">
            <p>Cuéntanos qué necesitas. Te atendemos desde La Dorada, Caldas, Colombia.</p>
            <a class="button button-dark" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp <span aria-hidden="true">↗</span></a>
            <a class="phone" href="tel:+573114308935">+57 311 430 8935</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div class="footer-brand"><img src="/images/logo-jc-led.png" width="220" height="156" loading="lazy" alt="JC LED Electronics" /><p>Audio, iluminación y tecnología</p></div>
        <div><p class="footer-label">Contacto</p><a href="tel:+573114308935">+57 311 430 8935</a><p>La Dorada, Caldas, Colombia</p></div>
        <div><p class="footer-label">Navegación</p><a href="#servicios">Servicios</a><a href="#proyectos">Proyectos</a><a href="#nosotros">Nosotros</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} JC LED Electronics</span><span>Hecho en La Dorada</span></div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Atkinson'; src: url('/fonts/atkinson-regular.woff') format('woff'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Atkinson'; src: url('/fonts/atkinson-bold.woff') format('woff'); font-weight: 700; font-display: swap; }
  :root { --ink:#05080a; --surface:#0b1013; --surface-2:#10171b; --paper:#f3f7f8; --muted:#99a7ae; --line:rgba(255,255,255,.12); --cyan:#00e4ef; --cyan-deep:#00aebd; --max:1240px; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; background:var(--ink); }
  body { margin:0; font-family:'Atkinson',Arial,sans-serif; color:var(--paper); background:var(--ink); font-size:18px; line-height:1.5; overflow-x:hidden; }
  body::selection { background:var(--cyan); color:var(--ink); }
  img { display:block; max-width:100%; }
  a { color:inherit; }
  .container { width:min(calc(100% - 48px),var(--max)); margin-inline:auto; }
  .skip-link { position:fixed; top:10px; left:10px; z-index:100; padding:10px 14px; background:var(--cyan); color:var(--ink); transform:translateY(-150%); }
  .skip-link:focus { transform:translateY(0); }

  .site-header { position:absolute; inset:0 0 auto; z-index:10; border-bottom:1px solid rgba(255,255,255,.16); }
  .header-inner { height:88px; display:flex; align-items:center; justify-content:space-between; }
  .brand { width:170px; height:60px; overflow:hidden; display:grid; place-items:center; }
  .brand img { width:170px; height:120px; object-fit:contain; }
  .desktop-nav { display:flex; align-items:center; gap:30px; }
  .desktop-nav a { text-decoration:none; font-size:.9rem; letter-spacing:.03em; color:#dce7ea; transition:color .2s ease; }
  .desktop-nav a:hover,.desktop-nav a:focus-visible { color:var(--cyan); }
  .desktop-nav .nav-cta { padding:10px 17px; border:1px solid rgba(255,255,255,.4); }
  .mobile-nav { display:none; position:relative; }
  .mobile-nav summary { list-style:none; width:44px; height:44px; border:1px solid var(--line); display:grid; place-content:center; gap:5px; cursor:pointer; }
  .mobile-nav summary::-webkit-details-marker { display:none; }
  .mobile-nav summary span { width:20px; height:1px; background:white; }
  .mobile-nav nav { position:absolute; right:0; top:52px; min-width:210px; padding:12px; background:rgba(5,8,10,.98); border:1px solid var(--line); display:grid; }
  .mobile-nav nav a { padding:13px 12px; text-decoration:none; border-bottom:1px solid var(--line); }

  .hero { min-height:820px; height:100svh; position:relative; display:flex; align-items:flex-end; isolation:isolate; overflow:hidden; }
  .hero-image,.hero-shade,.hero-grid { position:absolute; inset:0; width:100%; height:100%; }
  .hero-image { object-fit:cover; object-position:center; z-index:-3; }
  .hero-shade { z-index:-2; background:linear-gradient(90deg,rgba(2,5,7,.96) 0%,rgba(2,5,7,.72) 44%,rgba(2,5,7,.16) 78%),linear-gradient(0deg,rgba(2,5,7,.82) 0%,transparent 48%); }
  .hero-grid { z-index:-1; opacity:.11; background-image:linear-gradient(rgba(0,228,239,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(0,228,239,.5) 1px,transparent 1px); background-size:64px 64px; mask-image:linear-gradient(90deg,black,transparent 70%); }
  .hero-content { padding-bottom:72px; }
  .eyebrow { margin:0 0 22px; display:flex; align-items:center; gap:12px; color:var(--cyan); text-transform:uppercase; letter-spacing:.16em; font-size:.76rem; font-weight:700; }
  .eyebrow span { width:32px; height:1px; background:currentColor; }
  h1,h2 { margin:0; font-size:clamp(3.9rem,9.2vw,8.5rem); line-height:.82; letter-spacing:-.055em; text-transform:uppercase; }
  h1 em,h2 em { color:var(--cyan); font-style:normal; }
  .hero-tagline { margin:26px 0 0; font-size:clamp(1.35rem,2.4vw,2rem); font-weight:700; letter-spacing:.01em; }
  .hero-copy { max-width:570px; color:#c1ccd0; font-size:1.05rem; margin:16px 0 30px; }
  .hero-actions { display:flex; gap:12px; flex-wrap:wrap; }
  .button { min-height:52px; padding:13px 20px; display:inline-flex; align-items:center; justify-content:space-between; gap:28px; border:1px solid transparent; text-decoration:none; font-weight:700; font-size:.94rem; transition:transform .2s ease,background .2s ease,color .2s ease; }
  .button:hover,.button:focus-visible { transform:translateY(-2px); }
  .button-primary { background:var(--cyan); color:var(--ink); }
  .button-primary:hover { background:white; }
  .button-ghost { border-color:rgba(255,255,255,.48); color:white; backdrop-filter:blur(8px); }
  .button-ghost:hover { border-color:var(--cyan); color:var(--cyan); }
  .hero-index { position:absolute; right:40px; bottom:42px; writing-mode:vertical-rl; color:rgba(255,255,255,.52); letter-spacing:.16em; font-size:.7rem; }

  .section { padding:130px 0; }
  .section-heading { display:grid; grid-template-columns:1.4fr .6fr; align-items:end; gap:60px; margin-bottom:72px; }
  .section-heading h2,.print-copy h2,.about h2,.contact h2 { font-size:clamp(3.1rem,7vw,6.4rem); }
  .section-heading>p { margin:0 0 6px; color:var(--muted); max-width:430px; }
  .services { background:var(--surface); }
  .services-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .service-card { min-height:265px; padding:28px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); position:relative; background:linear-gradient(135deg,rgba(0,228,239,.045),transparent 55%); }
  .service-card h3 { margin:52px 0 12px; font-size:1.4rem; line-height:1.1; }
  .service-card p { margin:0; color:var(--muted); font-size:.95rem; max-width:300px; }
  .service-number { position:absolute; top:25px; right:28px; color:var(--cyan); font-size:.72rem; letter-spacing:.12em; }
  .service-line { position:absolute; left:28px; top:33px; width:42px; height:2px; background:var(--cyan); transform-origin:left; transition:transform .25s ease; }
  .service-card:hover .service-line { transform:scaleX(2); }
  .service-card:last-child { grid-column:span 2; }

  .projects { background:var(--ink); }
  .projects-heading { margin-bottom:52px; }
  .project-grid { display:grid; grid-template-columns:1.35fr .65fr; grid-template-rows:repeat(2,330px); gap:14px; }
  .project-card { margin:0; position:relative; overflow:hidden; background:var(--surface-2); }
  .project-card.project-wide { grid-row:1 / 3; }
  .project-card img { width:100%; height:100%; object-fit:cover; transition:transform .55s cubic-bezier(.2,.7,.2,1); }
  .project-card:hover img { transform:scale(1.025); }
  .project-card::after { content:''; position:absolute; inset:45% 0 0; background:linear-gradient(transparent,rgba(0,0,0,.82)); }
  .project-card figcaption { position:absolute; z-index:1; left:24px; right:24px; bottom:22px; display:flex; justify-content:space-between; gap:20px; font-weight:700; }
  .project-card figcaption span { color:var(--cyan); font-size:.75rem; }

  .print-section { padding-top:70px; background:var(--ink); }
  .print-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(40px,8vw,110px); align-items:center; }
  .print-image-wrap { position:relative; max-width:520px; }
  .print-image-wrap::before { content:''; position:absolute; inset:-14px 14px 14px -14px; border:1px solid rgba(0,228,239,.42); z-index:0; }
  .print-image-wrap img { position:relative; width:100%; height:650px; object-fit:cover; z-index:1; }
  .image-label { position:absolute; right:-1px; bottom:0; z-index:2; padding:10px 14px; background:var(--cyan); color:var(--ink); text-transform:uppercase; letter-spacing:.12em; font-size:.68rem; font-weight:700; }
  .print-copy>p:not(.eyebrow) { max-width:560px; color:var(--muted); font-size:1.08rem; margin:30px 0; }
  .print-copy ul { list-style:none; padding:0; margin:0 0 34px; max-width:560px; }
  .print-copy li { padding:14px 0 14px 24px; border-bottom:1px solid var(--line); position:relative; }
  .print-copy li::before { content:'+'; position:absolute; left:0; color:var(--cyan); }
  .text-link { display:inline-flex; gap:18px; color:var(--cyan); text-underline-offset:6px; font-weight:700; }

  .about { background:var(--paper); color:var(--ink); }
  .about-grid { display:grid; grid-template-columns:.36fr 1fr .5fr; gap:55px; align-items:start; }
  .about .eyebrow { margin-top:9px; color:var(--cyan-deep); }
  .about h2 em { color:var(--cyan-deep); }
  .about-lead { margin:35px 0 0; max-width:760px; font-size:clamp(1.25rem,2.2vw,1.8rem); line-height:1.35; }
  .about-note { margin:10px 0 0; padding-left:20px; border-left:2px solid var(--cyan-deep); color:#536066; font-size:.95rem; }

  .contact { padding:95px 0; background:var(--cyan); color:var(--ink); }
  .contact-inner { display:grid; grid-template-columns:1.3fr .7fr; gap:70px; align-items:end; }
  .eyebrow.light { color:var(--ink); }
  .contact h2 em { color:white; text-shadow:0 0 1px var(--ink); }
  .contact-actions p { margin:0 0 24px; max-width:430px; }
  .button-dark { background:var(--ink); color:white; width:100%; }
  .button-dark:hover { background:white; color:var(--ink); }
  .phone { display:inline-block; margin-top:20px; font-weight:700; text-underline-offset:5px; }

  footer { padding:65px 0 28px; background:var(--ink); }
  .footer-inner { display:grid; grid-template-columns:1.6fr .7fr .5fr; gap:40px; }
  .footer-brand img { width:170px; height:90px; object-fit:contain; margin-bottom:4px; }
  .footer-brand p,footer div>p { color:var(--muted); margin:5px 0; font-size:.9rem; }
  .footer-label { color:var(--cyan)!important; text-transform:uppercase; letter-spacing:.13em; font-size:.7rem!important; margin-bottom:14px!important; }
  .footer-inner>div>a { display:block; font-size:.9rem; margin:5px 0; text-decoration:none; }
  .footer-inner>div>a:hover { color:var(--cyan); }
  .footer-bottom { margin-top:45px; padding-top:20px; border-top:1px solid var(--line); display:flex; justify-content:space-between; color:#68777d; font-size:.72rem; text-transform:uppercase; letter-spacing:.1em; }
  :focus-visible { outline:2px solid var(--cyan); outline-offset:4px; }

  @media (max-width:960px) {
    .desktop-nav { display:none; } .mobile-nav { display:block; } .hero { min-height:760px; }
    .hero-shade { background:linear-gradient(90deg,rgba(2,5,7,.92),rgba(2,5,7,.34)),linear-gradient(0deg,rgba(2,5,7,.84),transparent 65%); }
    .section-heading { grid-template-columns:1fr; gap:28px; } .services-grid { grid-template-columns:repeat(2,1fr); } .service-card:last-child { grid-column:auto; }
    .project-grid { grid-template-columns:1fr 1fr; grid-template-rows:470px 300px; } .project-card.project-wide { grid-column:1 / 3; grid-row:auto; }
    .print-grid { gap:50px; } .print-image-wrap img { height:560px; }
    .about-grid { grid-template-columns:1fr 2fr; } .about-note { grid-column:2; } .contact-inner { grid-template-columns:1fr; }
  }
  @media (max-width:640px) {
    body { font-size:16px; } .container { width:min(calc(100% - 30px),var(--max)); } .header-inner { height:74px; } .brand { width:140px; } .brand img { width:145px; }
    .hero { min-height:720px; height:100svh; } .hero-image { object-position:58% center; }
    .hero-shade { background:linear-gradient(90deg,rgba(2,5,7,.88),rgba(2,5,7,.38)),linear-gradient(0deg,rgba(2,5,7,.95) 0%,rgba(2,5,7,.2) 70%); }
    .hero-content { padding-bottom:42px; } h1 { font-size:clamp(2.9rem,12.5vw,4.2rem); } .hero-tagline { margin-top:20px; } .hero-copy { font-size:1rem; }
    .hero-actions { display:grid; grid-template-columns:1fr 1fr; } .button { gap:12px; padding:12px 14px; } .hero-index { display:none; }
    .section { padding:90px 0; } .section-heading { margin-bottom:45px; }
    .section-heading h2,.print-copy h2,.about h2,.contact h2 { font-size:clamp(2.75rem,14vw,4.2rem); }
    .services-grid { grid-template-columns:1fr; } .service-card { min-height:230px; }
    .project-grid { grid-template-columns:1fr; grid-template-rows:430px 270px 270px; } .project-card.project-wide { grid-column:auto; }
    .print-section { padding-top:25px; } .print-grid { grid-template-columns:1fr; } .print-image-wrap { margin-left:14px; } .print-image-wrap img { height:480px; }
    .about-grid { grid-template-columns:1fr; gap:18px; } .about-note { grid-column:auto; margin-top:12px; }
    .contact { padding:75px 0; } .contact-inner { gap:42px; }
    .footer-inner { grid-template-columns:1fr 1fr; } .footer-brand { grid-column:1 / 3; }
    .footer-bottom { align-items:flex-start; gap:12px; flex-direction:column; }
  }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition-duration:.01ms!important; } }
</style>
